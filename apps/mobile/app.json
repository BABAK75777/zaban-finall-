{
  "expo": {
    "name": "Mamlio",
    "slug": "zaban-tts",
    "scheme": "mamlio",
    "version": "1.3.3",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A30"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babakworks.mamlio",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Allow Mamlio to record your voice for speaking and playback practice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.babakworks.mamlio",
      "versionCode": 136,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mamlio"
            },
            {
              "scheme": "zaban-tts"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A30"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Mamlio to record your voice for speaking and playback practice.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mamlio to read text from your photos.",
          "cameraPermission": "Allow Mamlio to take photos for text recognition."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8b37435e-cfd3-436c-8017-25e99b82bb90"
      },
      "companyName": "Babak Works",
      "displayName": "Mamlio by Babak Works",
      "websiteUrl": "https://babakworks.com"
    }
  }
}
