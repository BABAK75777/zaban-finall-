# Copy to .env and adjust for local development.

# API (optional — defaults in src/config/apiBaseUrl.ts)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# AdMob — banner ads use Google's test unit by default (safe for on-device testing):
#   ca-app-pub-3940256099942544/6300978111
# Production banner is only used when you explicitly opt in:
#   EXPO_PUBLIC_ADMOB_USE_PRODUCTION_IDS=1
# Optional override for store builds:
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-2133767058275325/7034060635
# EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-XXXX/ZZZZ

# Force Google sample App ID in native config during local builds:
# EXPO_PUBLIC_ADMOB_USE_TEST_IDS=1

# Disable all ads (E2E / validation runs):
# EXPO_PUBLIC_VALIDATION_BUILD=1

# Soft update check (optional JSON endpoint):
# EXPO_PUBLIC_UPDATE_CHECK_URL=https://example.com/mamlio-update.json
# EXPO_PUBLIC_UPDATE_FALLBACK_URL=https://play.google.com/store/apps/details?id=com.babakworks.mamlio
